# =============================================================================
# Environment variables for The Superhero
#
# Copy to `.env.local` for local dev and fill in. In Vercel, set these per
# environment scope (Production vs Preview) — see DEPLOYMENT.md. Never commit
# real values; this template lists NAMES only.
# =============================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Runtime uses the POOLED connection (PgBouncer, port 6543). Append
# ?pgbouncer=true. Use the matching project's URL per environment.
DATABASE_URL=

# Optional: DIRECT connection (port 5432), only needed for `prisma migrate dev`
# locally. The migration runner (npm run db:apply) uses DATABASE_URL.
DIRECT_URL=

# --- Clerk (auth) ------------------------------------------------------------
# Development instance keys (pk_test…/sk_test…) for local + Preview.
# Production instance keys (pk_live…/sk_live…) go in the Vercel Production scope.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (one per Clerk instance → per Vercel scope).
# Endpoint: <site-url>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# Auth route paths (same across environments).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Supabase Storage (avatars + project covers) ----------------------------
# Project URL, e.g. https://<ref>.supabase.co — next.config.ts derives the
# allowed next/image host from this at build time.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only service_role key (full storage access). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ----------------------------------------------------------
# API key from resend.com. UNSET in local dev is fine: emails are logged
# (confirm/unsubscribe links included) instead of sent, so the flows still work.
# Production needs a key AND a verified sending domain (SPF/DKIM/DMARC on
# thesuperhe.ro) — see DEPLOYMENT.md.
RESEND_API_KEY=
# From address for all outbound mail. Must be on the verified domain.
EMAIL_FROM="The Superhero <hello@thesuperhe.ro>"

# --- Site + cron -------------------------------------------------------------
# Canonical public origin — used for links inside emails (confirm, unsubscribe)
# and OG metadata. Defaults to https://thesuperhe.ro when unset.
NEXT_PUBLIC_SITE_URL=
# Shared secret for the notification-email cron (Vercel sends it as a Bearer
# token). The cron endpoint is inert until this is set.
CRON_SECRET=
